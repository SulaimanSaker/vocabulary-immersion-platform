# Copy this file to .env and fill in your key.
# Get a FREE Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Port the backend API listens on (default 3000)
PORT=3000

# Optional: which Gemini model to use (default: gemini-2.5-flash-lite).
# flash-lite has the most generous free-tier limits. Other options:
#   gemini-2.0-flash, gemini-2.5-flash (higher quality, smaller free quota)
# GEMINI_MODEL=gemini-2.5-flash-lite
