# Copy this file to .env and fill in the values.

# Secret used to sign login session cookies. Use any long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the backend API listens on (default 3000). Azure App Service sets this automatically.
PORT=3000

# Set to "production" when deployed (enables secure HTTPS-only session cookies).
# NODE_ENV=production

# Where the SQLite database file lives.
# Local default: ./data.db (relative to the server folder).
# On Azure App Service, point this at the persistent /home volume, e.g.:
#   VIP_DB_FILE=/home/data/data.db
# VIP_DB_FILE=

# Optional: which Gemini model to use (default: gemini-2.5-flash-lite).
# flash-lite has the most generous free-tier limits. Other options:
#   gemini-2.0-flash, gemini-2.5-flash (higher quality, smaller free quota)
# GEMINI_MODEL=gemini-2.5-flash-lite

# NOTE: there is no shared Gemini API key — each signed-in user enters their own
# key in the app's Settings (it stays in their browser).
