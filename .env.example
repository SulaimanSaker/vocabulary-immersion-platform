# Copy this file to .env and fill in the values.

# Secret used to sign login session cookies. Use any long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the backend API listens on (default 3000)
PORT=3000

# Optional: which Gemini model to use (default: gemini-2.5-flash-lite).
# flash-lite has the most generous free-tier limits. Other options:
#   gemini-2.0-flash, gemini-2.5-flash (higher quality, smaller free quota)
# GEMINI_MODEL=gemini-2.5-flash-lite

# NOTE: there is no shared GEMINI_API_KEY anymore — each signed-in user enters
# their own Gemini key in the app's Settings (it stays in their browser).
